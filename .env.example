# BotcWeb — variables d'environnement
# Copier en .env.local et remplir les valeurs.

# ─── Persistance ────────────────────────────────────────────────────────────
# Redis : stockage de l'état des parties (TTL 24h).
# Local : `docker run -p 6379:6379 redis` puis REDIS_URL=redis://localhost:6379
# Prod  : URL fournie par Railway / Render / Upstash
REDIS_URL=redis://localhost:6379

# PostgreSQL : utilisé à partir du lot 2 (comptes + historique). Optionnel au lot 1.
# Local : `docker run -p 5432:5432 -e POSTGRES_PASSWORD=botc -e POSTGRES_DB=botc postgres`
# Prod  : URL fournie par le PaaS (Neon, Supabase, Railway Postgres, etc.)
DATABASE_URL=postgresql://postgres:botc@localhost:5432/botc

# ─── Pusher Channels (temps réel) ───────────────────────────────────────────
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=eu
