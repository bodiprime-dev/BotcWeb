// Schéma Prisma pour BotcWeb.
//
// Lot 1 : pas encore de modèles — la base PostgreSQL est mise en place mais
// inutilisée. Les tables User / Account / Session / GameRecord arrivent au
// lot 2 (auth) et lot 3 (historique).
//
// Pour générer le client : `npm run db:generate`
// Pour appliquer les migrations en prod : `npm run db:migrate`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
